{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Solis",
  "version": "0.3.0",
  "identifier": "io.github.phsanalytics.solis",
  "build": {
    "beforeDevCommand": "pnpm vite",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist/web"
  },
  "app": {
    "windows": [
      {
        "title": "Solis",
        "width": 1100,
        "height": 780,
        "minWidth": 360,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "license": "Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
